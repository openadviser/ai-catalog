    {
      "id": "basis-replay-window",
      "rule": "BASIS-3",
      "kind": "priceFromBasis",
      "title": "A basis keeps the rates it was admitted at",
      "request": {
        "basisFrom": "price-window-before",
        "basis": "{\"basisVersion\":1,\"conditionInputs\":{},\"currency\":\"USD\",\"model\":{\"id\":\"vector-dated\",\"requested\":\"vector-dated\"},\"origin\":{\"kind\":\"catalog\",\"sha256\":\"881d46572142a01acf65388a41d3988aefea90c0519c20d76f770ecc93fdcc91\",\"version\":\"2026.11.04.1\"},\"provider\":\"google-gemini\",\"rounding\":{\"exponent\":2,\"rule\":\"half-up-once-on-total\",\"settlement\":\"booked\"},\"schedules\":[{\"components\":[{\"amount\":\"0.5\",\"component\":\"cache_storage\",\"disposition\":\"priced\",\"factor\":null,\"meter\":null,\"per\":1000000,\"unit\":\"token-hour\",\"validFrom\":null,\"validUntil\":\"2027-01-01T00:00:00Z\"},{\"component\":\"grounding_search\",\"disposition\":\"unsupported\"},{\"amount\":\"0.75\",\"component\":\"input\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":\"2027-01-01T00:00:00Z\"},{\"amount\":\"0.075\",\"component\":\"input_cached\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":\"2027-01-01T00:00:00Z\"},{\"amount\":\"3.75\",\"component\":\"output\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":\"2027-01-01T00:00:00Z\"}],\"condition\":null}],\"tier\":\"google-gemini:standard\"}",
        "basisSha256": "4b32f09e21ab1a244ae14909e5ae59a05799bbd091cf938d3c494174bb0966cd",
        "usage": {
          "completeness": "complete",
          "quantities": {
            "input": 100000,
            "input_cached": 20000,
            "output": 40000,
            "grounding_search": 0
          }
        }
      },
      "derivation": [
        "The basis of price-window-before holds the 2026 rates. Replay takes no instant, so a settlement after the step still prices at them.",
        "input: 100000 * 0.75 / 10^6 = 0.075",
        "input_cached: 20000 * 0.075 / 10^6 = 0.0015",
        "output: 40000 * 3.75 / 10^6 = 0.15",
        "exact = 0.2265 = 453/2000",
        "estimate = floor((2*453*100 + 2000) / 4000) = floor(92600/4000) = 23 -> 0.23",
        "booked = 0.23"
      ],
      "expected": {
        "currency": "USD",
        "schedule": 0,
        "exact": "453/2000",
        "estimate": "0.23",
        "booked": "0.23"
      }
