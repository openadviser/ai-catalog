    {
      "id": "price-condition-inputs-invalid",
      "rule": "API-1",
      "kind": "price",
      "title": "A conditionInputs that is not { inputTokens: \"unknown\" }",
      "catalog": {
        "fixture": "text.json"
      },
      "request": {
        "provider": "anthropic",
        "modelId": "vector-text",
        "tier": "anthropic:standard",
        "at": "2026-11-04T12:00:00Z",
        "settlement": "booked",
        "usage": {
          "completeness": "complete",
          "quantities": {
            "input": 1000,
            "input_cached": 0,
            "cache_write_5m": 0,
            "output": 0,
            "web_search": 0,
            "code_execution": 0
          }
        },
        "conditionInputs": {
          "inputTokens": "known"
        }
      },
      "derivation": [
        "conditionInputs.inputTokens is \"known\" (PRICE-1, API-1).",
        "The offering has no conditions, which would ignore a well-formed conditionInputs (COND-7), but a malformed one is refused first."
      ],
      "expectedError": {
        "code": "invalid-request"
      }
    },
    {
      "id": "basis-replay-condition-inputs-invalid",
      "rule": "API-1",
      "kind": "priceFromBasis",
      "title": "priceFromBasis with a conditionInputs that is not { inputTokens: \"unknown\" }",
      "derivation": [
        "price-sub-cent's basis, which is valid, with conditionInputs.inputTokens \"known\" (API-1).",
        "The basis is checked first and passes; the conditionInputs is then refused."
      ],
      "request": {
        "basisFrom": "price-sub-cent",
        "basis": "{\"basisVersion\":1,\"conditionInputs\":{},\"currency\":\"USD\",\"model\":{\"id\":\"vector-text\",\"requested\":\"vector-text\"},\"origin\":{\"kind\":\"catalog\",\"sha256\":\"9427faa24c8cd47892f9da51ae9205ed1a3ad98d5a3468cabf95ced5be314237\",\"version\":\"2026.11.04.1\"},\"provider\":\"anthropic\",\"rounding\":{\"exponent\":2,\"rule\":\"half-up-once-on-total\",\"settlement\":\"booked\"},\"schedules\":[{\"components\":[{\"component\":\"cache_write_1h\",\"disposition\":\"inapplicable\"},{\"component\":\"cache_write_5m\",\"disposition\":\"no-rate\"},{\"component\":\"code_execution\",\"disposition\":\"unsupported\"},{\"amount\":\"1.25\",\"component\":\"input\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":null},{\"amount\":\"0.125\",\"component\":\"input_cached\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":null},{\"amount\":\"10\",\"component\":\"output\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"token\",\"per\":1000000,\"unit\":\"token\",\"validFrom\":null,\"validUntil\":null},{\"amount\":\"10\",\"component\":\"web_search\",\"disposition\":\"priced\",\"factor\":1,\"meter\":\"request\",\"per\":1000,\"unit\":\"request\",\"validFrom\":null,\"validUntil\":null}],\"condition\":null}],\"tier\":\"anthropic:standard\"}",
        "basisSha256": "1c226f29966d9cabc13fdcd81126459aebeb93ebb7576ce79c47590cffbd5c26",
        "conditionInputs": {
          "inputTokens": "known"
        },
        "usage": {
          "completeness": "complete",
          "quantities": {
            "input": 1000,
            "input_cached": 0,
            "cache_write_5m": 0,
            "output": 0,
            "web_search": 0,
            "code_execution": 0
          }
        }
      },
      "expectedError": {
        "code": "invalid-request"
      }
    },
    {
      "id": "convert-scale-too-large",
      "rule": "API-1",
      "kind": "convert",
      "title": "A scale of 13",
      "request": {
        "rate": {
          "unit": "minute",
          "per": 1,
          "amount": "0.15"
        },
        "to": {
          "unit": "millisecond",
          "per": 1000000,
          "scale": 13
        }
      },
      "derivation": ["scale 13 is above 12 (API-1, UNIT-4)."],
      "expectedError": {
        "code": "invalid-request"
      }
    },
