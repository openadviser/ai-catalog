{
  "description": "Arguments the public operations refuse with a code (API-1).",
  "vectors": [
    {
      "id": "price-request-not-object",
      "rule": "API-1",
      "kind": "price",
      "title": "A request that is null",
      "catalog": {
        "fixture": "text.json"
      },
      "request": null,
      "derivation": ["The request is null, not an object (API-1, PRICE-1)."],
      "expectedError": {
        "code": "invalid-request"
      }
    },
    {
      "id": "price-request-array",
      "rule": "API-1",
      "kind": "price",
      "title": "A request that is an array",
      "catalog": {
        "fixture": "text.json"
      },
      "request": [],
      "derivation": ["The request is an empty array: an array is not an object (API-1, PRICE-1)."],
      "expectedError": {
        "code": "invalid-request"
      }
    },
    {
