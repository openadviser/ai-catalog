t;basepath&quot;:[0,&quot;/docs&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;searchLocale&quot;:[0,&quot;en&quot;],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;askAiEnabled&quot;:[0,false],&quot;localDev&quot;:[0,false]}" ssr client="only" opts="{&quot;name&quot;:&quot;SearchDialogShell&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island><div data-astro-transition-persist="fern-custom-js-holder" id="fern-custom-js-holder"></div><script>(function(){var c=document.currentScript;var s=document.createElement("script");s.text="(function(){const bodyScripts = [{\"src\":\"https://elevenlabs.io/player/audioNativeHelper.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/d79520411e2261ace07cfab8ee53b6ea364214322253c745dba7acc35ff342c8/assets/scripts/widget.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/3d76a72196c1b8e43cc6a989b28d40e6428b542a3ee363f8a07472382d01afcc/assets/scripts/audio-player.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/5134a52dcf1861899a438d2585db872754836a8ccbb933f17626f2ccc69dd7ef/assets/scripts/accordion-single-expand.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/f9293ea6e94ee0e33352418bd61475e4dca40634ae1a4d4f743cdf4676e214d5/assets/scripts/api-signup-link.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/3f00e6ff6d1d8caf871bd90d1631da009a25f7db425481e435834b3fd9ff0f7f/assets/scripts/tts-cta-experiment.js\",\"strategy\":\"lazyOnload\"}];\n\n        (function () {\n          // Inject each docs-configured script once. `src` scripts already on\n          // the page (data-fern-custom-js) are left in place — the docs scripts\n          // handle SPA re-init themselves; inline scripts run once.\n          //\n          // Injected elements go into #fern-custom-js-holder — a\n          // `transition:persist` container — rather than document.body. Without\n          // it the injected \u003cscript> was removed by every body swap, so the\n          // dedup below lost the element and re-injected it on every\n          // `astro:page-load`, re-executing the script each navigation (a\n          // classic script with top-level `const`/`let` bindings then throws\n          // \"Identifier ... has already been declared\" and its re-render\n          // observers never re-register).\n          //\n          // Persisting the element is not enough on its own: after each swap the\n          // ClientRouter re-runs every \u003cscript> in the document that is not\n          // marked `data-astro-exec` (cloning + replacing the element), which\n          // would execute the persisted script a second time. Mark injected\n          // scripts as already executed so the router leaves them alone. Must be\n          // set BEFORE the element is inserted — an unstamped node in the\n          // document is exactly what the router clones.\n          function markExecuted(el) {\n            el.setAttribute(\"data-astro-exec\", \"\");\n          }\n          function injectFernCustomScripts() {\n            const holder = document.getElementById(\"fern-custom-js-holder\") || document.body;\n            for (const s of bodyScripts) {\n              if (s.src) {\n                if (document.querySelector('script[data-fern-custom-js=\"' + s.src + '\"]')) { continue; }\n                const el = document.createElement(\"script\");\n                el.src = s.src;\n                // Script-inserted scripts ignore `defer` and default to async, so\n                // they ran in download order. Classic scripts share one global\n                // lexical scope, so order matters: two bundles that both declare\n                // a top-level `const`/`let` of the same name throw \"Identifier\n                // ... has already been declared\" in whichever runs second.\n                // `async = false` runs them in docs.yml order, like next/script.\n                el.async = false;\n                el.setAttribute(\"data-fern-custom-js\", s.src);\n                if (s.integrity) { el.integrity = s.integrity; el.crossOrigin = \"anonymous\"; }\n                markExecuted(el);\n                holder.appendChild(el);\n              } else if (s.inline) {\n                if (document.querySelector(\"script[data-fern-custom-inline='\" + encodeURIComponent(s.inline) + \"']\")) { continue; }\n                const el = document.createElement(\"script\");\n                el.textContent = s.inline;\n                el.setAttribute(\"data-fern-custom-inline\", encodeURIComponent(s.inline));\n                markExecuted(el);\n                holder.appendChild(el);\n              }\n            }\n          }\n          if (!window.__fernCustomScriptsBound) {\n            window.__fernCustomScriptsBound = true;\n            // Bind per-page on each `astro:page-load` (initial load + every\n            // ClientRouter navigation) and inject once the page's React islands\n            // — MDX content, header, footer, endpoint reference — have hydrated.\n            // A customer script that edits their server-rendered DOM before\n            // that (renaming \"Copy page\", removing #builtwithfern, translating\n            // the footer prompt) makes React see markup it didn't render\n            // (React #418), re-render the island and discard the script's\n            // edits. next/script only runs these after the whole Next page has\n            // hydrated, so this page hydrates every island up front\n            // (`\u003chtml data-fern-hydrate-all>` turns `client:lazy` into\n            // hydrate-on-idle; `client:deferred` already is) and waits until\n            // every such island carries `data-fern-hydrated`, which the patched\n            // @astrojs/react client stamps from a passive effect once React has\n            // com