{
  "name": "ai-catalog",
  "private": true,
  "description": "Prices, models and effort levels for AI APIs, read from the providers' official pages and published as versioned JSON.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openadviser/ai-catalog.git"
  },
  "bugs": "https://github.com/openadviser/ai-catalog/issues",
  "homepage": "https://github.com/openadviser/ai-catalog#readme",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "workspaces": [
    "clients/*",
    "readers/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "read": "node readers/cli.ts",
    "reconcile": "node reconcile/src/cli.ts",
    "update:dry-run": "node reconcile/src/cli.ts dry-run",
    "links": "node scripts/check-links.ts",
    "coverage:table": "node scripts/coverage-table.ts",
    "coverage:check": "node scripts/coverage-table.ts --check",
    "conformance:check": "node scripts/check-conformance.ts && node conformance/tools/pin.ts --check",
    "conformance:pin": "node conformance/tools/pin.ts --write",
    "data:check": "node scripts/check-data.ts",
    "data:hash": "node scripts/check-data.ts --hash",
    "check": "npm run typecheck && npm run lint && npm run test && npm run links && npm run coverage:check && npm run conformance:check && npm run data:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "ajv": "8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
