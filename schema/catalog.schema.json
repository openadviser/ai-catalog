{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openadviser/ai-catalog/schema/1.0.0/catalog.schema.json",
  "title": "AI catalog",
  "description": "The catalog of prices, models and effort levels, schema 1.0.0. The rules no schema can express are in docs/specification.md, Section 14.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "publishedAt", "providers"],
  "properties": {
    "schemaVersion": {
      "description": "SemVer of this schema. A 1.0.0 client accepts 1.0.x (VAL-3).",
      "type": "string",
      "pattern": "^1\\.0\\.(0|[1-9][0-9]*)$"
    },
    "version": { "$ref": "#/$defs/version" },
    "publishedAt": { "$ref": "#/$defs/instant" },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "version": {
      "description": "YYYY.MM.DD.N, the release's UTC date and a 1-based sequence number (VER-1).",
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12][0-9]|3[01])\\.[1-9][0-9]*$"
    },
    "instant": {
      "description": "RFC 3339 UTC, whole seconds (TIME-1). Calendar validity is a semantic check.",
      "type": "string",
      "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "instantAt": {
      "description": "RFC 3339 UTC with up to three fractional digits, for the instant a call is priced at (TIME-1).",
      "type": "string",
      "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "amount": {
      "description": "A nonnegative decimal string, at most twelve fractional digits (NUM-1).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "per": {
      "description": "A power of ten from 1 to 10^9 (NUM-2).",
      "enum": [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "currency": {
      "description": "The 1.0.0 currency vocabulary (ROUND-1).",
      "enum": ["USD", "EUR", "GBP"]
    },
    "providerId": {
      "enum": ["anthropic", "openai", "google-gemini", "elevenlabs"]
    },
    "tier": {
      "description": "The 1.0.0 tier vocabulary (TIER-1). The prefix must equal the provider id, a semantic check.",
      "enum": [
        "anthropic:standard",
        "anthropic:batch",
        "openai:standard",
        "google-gemini:standard",
        "elevenlabs:pay-as-you-go"
      ]
    },
    "unit": {
      "description": "Unit kinds (UNIT-1).",
      "enum": [
        "token",
        "character",
        "request",
        "millisecond",
        "second",
        "minute",
        "hour",
        "token-hour"
      ]
    },
    "component": {
      "description": "The closed component vocabulary (COMP-1).",
      "enum": [
        "input",
        "input_cached",
        "cache_write_5m",
        "cache_write_1h",
        "cache_write_30m",
        "cache_write_12h",
        "output",
        "output_audio",
        "characters",
        "output_audio_duration",
        "web_search",
        "file_search",
        "grounding_search",
        "grounding_maps",
        "code_execution",
        "containers",
        "cache_storage",
        "file_search_storage"
      ]
    },
    "tokenComponent": {
      "enum": [
        "input",
        "input_cached",
        "cache_write_5m",
        "cache_write_1h",
        "cache_write_30m",
        "cache_write_12h",
        "output",
        "output_audio"
      ]
    },
    "effortLevel": {
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "capability": {
      "enum": [
        "text-generation",
        "speech-synthesis",
        "music-generation",
        "sound-effects-generation"
      ]
    },
    "location": {
      "description": "Where a value sits in its evidence: a human path, and the exact bytes at a byte offset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "offset", "excerpt"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 600 },
        "anchors": {
          "description": "Further cited bytes in the same evidence, such as the row label or the column header.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "excerpt"],
            "properties": {
              "offset": { "type": "integer", "minimum": 0 },
              "excerpt": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        }
      }
    },
    "derivation": {
      "description": "A value the source states as a rule over other stated values. Every input is cited.",
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "inputs"],
      "properties": {
        "formula": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence", "url", "path", "offset", "excerpt"],
            "properties": {
              "evidence": { "$ref": "#/$defs/sha256" },
              "url": { "type": "string", "pattern": "^https://" },
              "path": { "type": "string", "minLength": 1 },
              "offset": { "type": "integer", "minimum": 0 },
              "excerpt": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        }
      }
    },
    "provenance": {
      "description": "Where a value was read: the source, the page, when, by what, and its evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "readAt", "reader", "evidence"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "url": { "type": "string", "pattern": "^https://" },
        "readAt": { "$ref": "#/$defs/instant" },
        "reader": {
          "description": "\"manual\" for a value entered by hand, otherwise <reader>@<version>.",
          "type": "string",
          "pattern": "^(manual|[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "evidence": { "$ref": "#/$defs/sha256" },
        "location": { "$ref": "#/$defs/location" },
        "derivation": { "$ref": "#/$defs/derivation" },
        "dateRule": { "enum": ["undated", "date-only-utc", "date-only-zoned", "stated-instant"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["location"], "not": { "required": ["derivation"] } },
        { "required": ["derivation"], "not": { "required": ["location"] } }
      ]
    },
    "rateProvenance": {
      "allOf": [{ "$ref": "#/$defs/provenance" }, { "required": ["dateRule"] }]
    },
    "condition": {
      "description": "A half-open interval (gt, lte] over one named input (COND-1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens"],
      "properties": {
        "inputTokens": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "gt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "lte": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "disposition", "provenance"],
      "properties": {
        "component": { "$ref": "#/$defs/component" },
        "disposition": { "enum": ["priced", "inapplicable", "unsupported"] },
        "unit": { "$ref": "#/$defs/unit" },
        "per": { "$ref": "#/$defs/per" },
        "amount": { "$ref": "#/$defs/amount" },
        "currency": { "$ref": "#/$defs/currency" },
        "condition": { "$ref": "#/$defs/condition" },
        "validFrom": { "$ref": "#/$defs/instant" },
        "validUntil": { "$ref": "#/$defs/instant" },
        "reason": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/rateProvenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "priced" } } },
          "then": {
            "required": ["unit", "per", "amount", "currency"],
            "not": { "required": ["reason"] }
          },
          "else": {
            "required": ["reason"],
            "properties": { "unit": false, "per": false, "amount": false, "currency": false }
          }
        },
        {
          "if": {
            "required": ["unit"],
            "properties": { "component": { "$ref": "#/$defs/tokenComponent" } }
          },
          "then": { "properties": { "unit": { "const": "token" } } }
        },
        {
          "if": { "required": ["unit"], "properties": { "component": { "const": "characters" } } },
          "then": { "properties": { "unit": { "const": "character" } } }
        },
        {
          "if": {
            "required": ["unit"],
            "properties": {
              "component": {
                "enum": ["web_search", "file_search", "grounding_search", "grounding_maps"]
              }
            }
          },
          "then": { "properties": { "unit": { "const": "request" } } }
        },
        {
          "if": {
            "required": ["unit"],
            "properties": {
              "component": { "enum": ["output_audio_duration", "code_execution", "containers"] }
            }
          },
          "then": {
            "properties": { "unit": { "enum": ["millisecond", "second", "minute", "hour"] } }
          }
        },
        {
          "if": {
            "required": ["unit"],
            "properties": { "component": { "const": "cache_storage" } }
          },
          "then": { "properties": { "unit": { "const": "token-hour" } } }
        },
        {
          "if": {
            "required": ["disposition"],
            "properties": {
              "component": { "const": "file_search_storage" },
              "disposition": { "const": "priced" }
            }
          },
          "then": false
        }
      ]
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rates"],
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "conditionInputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens"],
          "properties": {
            "inputTokens": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/component" }
            }
          }
        },
        "rates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rate" }
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/modelId" },
        "status": { "enum": ["active", "retired"] }
      }
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 200
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "default", "provenance"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effortLevel" }
        },
        "default": {
          "anyOf": [{ "$ref": "#/$defs/effortLevel" }, { "type": "null" }]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "status", "capabilities", "offerings", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/modelId" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "status": { "enum": ["preview", "available", "deprecated", "retired"] },
        "retiresOn": { "$ref": "#/$defs/date" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "effort": { "$ref": "#/$defs/effort" },
        "offerings": { "type": "array", "items": { "$ref": "#/$defs/offering" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "statusProvenance": { "$ref": "#/$defs/provenance" }
      },
      "if": {
        "anyOf": [
          { "required": ["retiresOn"] },
          {
            "required": ["status"],
            "properties": { "status": { "enum": ["preview", "deprecated", "retired"] } }
          }
        ]
      },
      "then": { "required": ["statusProvenance"] }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pricingUrls", "models"],
      "properties": {
        "id": { "$ref": "#/$defs/providerId" },
        "name": { "type": "string", "minLength": 1 },
        "pricingUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^https://" }
        },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
      }
    }
  }
}
