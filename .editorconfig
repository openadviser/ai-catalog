root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces can be a Markdown line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Saved source pages and evidence are stored byte for byte.
[{evidence/**,**/fixtures/**}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
